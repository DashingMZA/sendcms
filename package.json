{
  "name": "sendcms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @sendcms/database db:generate && pnpm sdk:build && turbo run build --concurrency 1",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "cf-typegen": "wrangler types --config apps/api/wrangler.jsonc --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:generate": "pnpm --filter @sendcms/database db:generate",
    "db:migrate": "pnpm --filter @sendcms/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @sendcms/database exec prisma migrate deploy",
    "db:reset": "npx tsx scripts/db-manager.ts reset",
    "db:seed": "pnpm --filter @sendcms/database db:seed",
    "db:status": "npx tsx scripts/db-manager.ts status",
    "db:studio": "pnpm --filter @sendcms/database db:studio",
    "dev": "pnpm --filter @sendcms/database db:generate && pnpm sdk:build && turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "eslint",
    "prepare": "husky",
    "sdk:build": "pnpm --filter @sendcms/sdk build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:setup": "tsx e2e/setup-e2e-user.ts",
    "check:workspace-imports": "node scripts/check-workspace-imports.mjs",
    "typecheck": "turbo run typecheck && tsc --noEmit && node scripts/check-workspace-imports.mjs",
    "validate:i18n": "pnpm --filter @sendcms/i18n validate"
  },
  "dependencies": {
    "@react-email/render": "^2.3.1",
    "@sendcms/shared": "workspace:*",
    "@sendcms/ui": "workspace:*",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@freemius/sdk": "^0.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.65.1",
    "@polar-sh/sdk": "^1.3.2",
    "@sendcms/admin-users": "workspace:*",
    "@sendcms/ai": "workspace:*",
    "@sendcms/ai-settings": "workspace:*",
    "@sendcms/analytics": "workspace:*",
    "@sendcms/api-client": "workspace:*",
    "@sendcms/api-keys": "workspace:*",
    "@sendcms/auth": "workspace:*",
    "@sendcms/billing": "workspace:*",
    "@sendcms/config": "workspace:*",
    "@sendcms/coupons": "workspace:*",
    "@sendcms/cron": "workspace:*",
    "@sendcms/database": "workspace:*",
    "@sendcms/domains": "workspace:*",
    "@sendcms/email": "workspace:*",
    "@sendcms/email-worker": "workspace:*",
    "@sendcms/forms": "workspace:*",
    "@sendcms/i18n": "workspace:*",
    "@sendcms/inbox": "workspace:*",
    "@sendcms/mcp": "workspace:*",
    "@sendcms/mcp-admin": "workspace:*",
    "@sendcms/notifications": "workspace:*",
    "@sendcms/observability": "workspace:*",
    "@sendcms/permissions": "workspace:*",
    "@sendcms/plans": "workspace:*",
    "@sendcms/platform-ops": "workspace:*",
    "@sendcms/queue": "workspace:*",
    "@sendcms/sdk": "workspace:*",
    "@sendcms/security": "workspace:*",
    "@sendcms/submissions": "workspace:*",
    "@sendcms/support": "workspace:*",
    "@sendcms/users": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dotenv-defaults": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai": "7.0.178",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jsdom": "31.0.1",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stripe": "^23.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "^4.164.0"
  }
}
