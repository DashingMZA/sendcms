{
  "name": "sendcms",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @sendcms/database db:generate && pnpm sdk:build && next dev --turbopack",
    "build": "pnpm --filter @sendcms/database db:generate && pnpm sdk:build && next build",
    "prepare": "husky",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "pnpm --filter @sendcms/database db:migrate",
    "db:generate": "pnpm --filter @sendcms/database db:generate",
    "db:seed": "pnpm --filter @sendcms/database db:seed",
    "db:studio": "pnpm --filter @sendcms/database db:studio",
    "db:status": "npx tsx scripts/db-manager.ts status",
    "db:reset": "npx tsx scripts/db-manager.ts reset",
    "build:cf": "pnpm --filter @sendcms/database db:generate && pnpm sdk:build && opennextjs-cloudflare build",
    "preview:cf": "pnpm build:cf && opennextjs-cloudflare preview",
    "deploy:cf": "pnpm build:cf && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "sdk:build": "pnpm --filter @sendcms/sdk build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next/third-parties": "16.4.6",
    "@react-email/render": "^2.3.1",
    "@remixicon/react": "^4.9.0",
    "@sendcms/analytics": "workspace:*",
    "@sendcms/api-client": "workspace:*",
    "@sendcms/auth": "workspace:*",
    "@sendcms/database": "workspace:*",
    "@sendcms/domains": "workspace:*",
    "@sendcms/forms": "workspace:*",
    "@sendcms/inbox": "workspace:*",
    "@sendcms/notifications": "workspace:*",
    "@sendcms/permissions": "workspace:*",
    "@sendcms/sdk": "workspace:*",
    "@sendcms/shared": "workspace:*",
    "@sendcms/submissions": "workspace:*",
    "@sendcms/ui": "workspace:*",
    "@sendcms/users": "workspace:*",
    "@tanstack/react-query": "^5.108.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.17",
    "lucide-react": "^1.74.0",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.15",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.17",
    "@sendcms/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dotenv-defaults": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jsdom": "31.0.1",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "^4.164.0"
  }
}
