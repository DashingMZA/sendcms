{
  "name": "open-remark",
  "version": "0.6.2",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "prisma generate && pnpm widget:build && next dev --turbopack",
    "build": "prisma generate && pnpm widget:build && next build",
    "prepare": "husky",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:status": "npx tsx scripts/db-manager.ts status",
    "db:reset": "npx tsx scripts/db-manager.ts reset",
    "db:benchmark:seed": "npx tsx scripts/benchmark/seed-benchmark-data.ts",
    "db:benchmark:run": "npx tsx scripts/benchmark/run-benchmark.ts",
    "widget:build": "tsx widget/build.ts",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@next/third-parties": "16.4.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/render": "^2.3.1",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.12",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dotenv-defaults": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.161.0"
  }
}
