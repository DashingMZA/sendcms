generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_USER
}

// Admin Control Plane (Phase 3) — account status. SUSPENDED is a temporary
// block (reversible via reactivate); DISABLED is an admin-closed account
// (reversible via restore). Deletion/erasure is a separate soft flow
// (deletion requests, Phase 7) — never a hard delete. A non-ACTIVE user
// cannot sign in or use any session-gated route; their public forms keep
// accepting submissions (never silently drop customer submissions).
enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

// Admin Control Plane (Phase 3) — staff roles for the admin app. Mirrors
// the AdminRole type in @sendcms/permissions (keep the two in sync).
// Null = plain customer, no staff role.
enum AdminRole {
  SUPER_ADMIN
  MANAGER
  SUPPORT
}

// ─── Contact forms (SendCMS, Phase 1) ───────────────────────────────────────

enum DomainStatus {
  PENDING // created, ownership not yet verified
  VERIFIED
  SUSPENDED // owner/admin suspended; submissions rejected until reactivated
}

enum DomainVerificationMethod {
  DNS_TXT
  META_TAG
  FILE
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum FormFieldType {
  TEXT
  EMAIL
  TEXTAREA
  NUMBER
  SELECT
  CHECKBOX
  RADIO
  URL
  TEL
  DATE
}

enum SubmissionStatus {
  NEW // unread
  READ
  STARRED
  ARCHIVED
  SPAM
}

enum SubmissionEventType {
  CREATED
  READ
  UNREAD
  STARRED
  UNSTARRED
  ARCHIVED
  RESTORED
  MARKED_SPAM
  EMAIL_SENT
  EMAIL_FAILED
}

enum EmailJobType {
  SUBMISSION_NOTIFICATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
  // Phase 12 (AI digest): a daily/weekly summary of a form's new
  // submissions, emailed to the form owner. The content is generated
  // at enqueue time and stored in EmailJob.payload.
  DIGEST
  // Phase 12 (AI reply drafts): an owner-written (or owner-edited)
  // reply to one submission, emailed to the submitter. The body is
  // stored in EmailJob.payload.
  SUBMISSION_REPLY
  // Phase 16 (EML-096): a test notification sent from a form's
  // detail page. Recorded as a SENT row (never PENDING) so the
  // delivery log shows test sends alongside real ones — the send
  // itself still goes straight through the provider, not the outbox.
  TEST_EMAIL
}

enum EmailJobStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VERIFY
  SUSPEND
  REACTIVATE
  // Admin Control Plane (Phase 4) — plan / subscription actions.
  PUBLISH
  MIGRATE
  CANCEL
  ARCHIVE
  ASSIGN
  // Admin Control Plane (Phase 9) — step-up re-authentication.
  // VERIFIED = the password check passed; FAILED = it did not (or no
  // password is set). The password itself never appears in the audit
  // detail.
  STEP_UP_VERIFIED
  STEP_UP_FAILED
}

enum AuditResource {
  DOMAIN
  FORM
  SUBMISSION
  USER
  SETTINGS
  API_KEY
  // Admin Control Plane (Phase 4) — plan / subscription / entitlement.
  PLAN
  SUBSCRIPTION
  ENTITLEMENT
  // Admin Control Plane (Phase 5) — a user's BYOK credential.
  AI_KEY
  // Admin Control Plane (Phase 6) — MCP global / per-user controls.
  MCP_SETTINGS
  // Admin Control Plane (Phase 7) — platform operations.
  FEATURE_FLAG
  ANNOUNCEMENT
  DELETION_REQUEST
  // Admin Control Plane (Phase 8) — billing providers + support tickets.
  BILLING_PROVIDER
  SUPPORT_TICKET
}

// ─── Platform operations (Admin Control Plane, Phase 7) ─────────────────────

// Outcome of an admin action, recorded on the audit row. FAILED rows
// exist so refused sensitive actions are visible, not invisible.
enum AuditOutcome {
  SUCCESS
  FAILED
}

// Who an announcement is shown to: ALL = customer dashboard banner +
// admin; ADMIN_ONLY = admin app only. Announcements are never emailed.
enum AnnouncementAudience {
  ALL
  ADMIN_ONLY
}

// Deletion-request workflow state. REQUESTED → APPROVED → COMPLETED
// (or REJECTED). The row is never deleted — it is the record that the
// erasure happened.
enum DeletionRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

// ─── Plans & entitlements (Admin Control Plane, Phase 4) ────────────────────

enum PlanKind {
  FREE
  PAID
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
  CUSTOM
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SubscriptionEventType {
  CREATED
  MIGRATED
  RENEWED
  CANCELED
  EXPIRED
  REACTIVATED
}

// What a UsageLedger row counts. One meter per resource family; the
// service maps each meter to the limit key in the effective plan
// version's entitlements.
enum UsageMeter {
  FORMS
  DOMAINS
  SUBMISSIONS
  API_KEYS
  MCP_REQUESTS
  AI_REQUESTS
}

// ─── AI provider & BYOK (Admin Control Plane, Phase 5) ──────────────────────

// The five AI providers. Mirrors AI_PROVIDERS in @sendcms/ai
// (packages/ai/src/provider.ts) — keep the two in sync.
enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  DEEPSEEK
  OPENROUTER
}

// How a user's AI usage is billed. BYOK = the user's own key;
// PLATFORM = the system's .env key; DISABLED = no AI for this user.
enum AiBillingMode {
  BYOK
  PLATFORM
  DISABLED
}

// Outcome of one AI call, for cost attribution.
enum AiUsageStatus {
  SUCCESS
  FAILED
  RETRY
}

// Result of the last Test-button call for a stored BYOK key.
enum AiKeyTestStatus {
  OK
  FAILED
  UNTESTED
}

// ─── API keys (MCP auth, Phase 11) ──────────────────────────────────────────

enum ApiKeyScope {
  READ // the 9 read-only MCP tools (list/get/overview) — no mutations
  FULL // all 19 MCP tools, including mutations
}

// ─── Auth (Better Auth 1.7.x required tables) ────────────────────────────────
// Better Auth's Prisma adapter expects these exact shapes: User.emailVerified
// is Boolean (not DateTime), Session is keyed by `token`, Account by
// `providerId`/`accountId`, and Verification holds email-verification tokens.
// (Auth.js tables were dropped in migration 20261117224500 — sendcms was never
// deployed, so no production rows existed.)

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  // DB-020 (Phase 16, Wave 3): hand-written partial unique index lives
  // outside this schema — Prisma cannot express a partial index.
  // Migration 20261117190655_single_platform_owner creates
  // "User_single_platform_owner_idx" (UNIQUE ON "User" ("platformRole")
  // WHERE "platformRole" = 'PLATFORM_OWNER'), which backs the atomic
  // first-user promotion: at most one PLATFORM_OWNER can exist. Do NOT
  // re-create this index in the schema (Prisma has no syntax for it)
  // and do NOT drop the migration. Drift check: `prisma migrate diff
  // --from-migrations --to-schema` is expected to report exactly this
  // one index as drift, and nothing else — that check stays open
  // because it needs a shadow DB, which does not exist on db.prisma.io
  // (owner decision 2026-11-24: fresh-DB test only, no shadow DB).
  platformRole  PlatformRole @default(PLATFORM_USER)
  // Admin Control Plane (Phase 3) — account status + staff role. `status`
  // gates sign-in and every session-gated route (enforced in the auth
  // session helper + both app proxies). `statusReason` holds the reason
  // for the current status (required when suspending/disabling, cleared
  // on reactivate/restore); the full history lives in AuditLog.
  status          UserStatus   @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?
  adminRole       AdminRole?
  // Deletion request (Admin Control Plane, Phase 3): the user (or an
  // admin on their behalf) asked for their account to be deleted. This
  // only RECORDS the request — the actual erasure workflow is Phase 7.
  // A requested deletion never hard-deletes anything by itself.
  deletionRequestedAt DateTime?
  deletionRequestReason String?
  // Set by the Phase 7 erasure workflow when the account is anonymized.
  // The row stays — billing/audit history must survive erasure.
  deletionCompletedAt DateTime?
  // Preferred UI locale (BCP 47 code, e.g. "en", "ur"). Null = no preference
  // set; the app falls back to English. Validated against the locale
  // registry in @sendcms/i18n (packages/i18n/src/locales.ts) — keep the
  // two in sync. Stored so a language switch (en -> ur) survives across
  // browsers and sessions; the browser cookie is the fast path.
  locale        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts         Account[]
  sessions         Session[]
  domains          Domain[]
  forms            Form[]
  // Phase 16 (PRF-011) — submissions owned directly, so the inbox /
  // quota / analytics queries filter on Submission.ownerId instead of
  // joining Form. Set from form.ownerId at create time; backfilled
  // from Form in the wave-3 ownerId migration.
  ownedSubmissions Submission[] @relation("SubmissionOwner")
  // Phase 16 (DB-034) — email jobs owned directly, so the outbox
  // listing filters on EmailJob.ownerId instead of joining Form. Set
  // from form.ownerId at enqueue time; backfilled from Form in the
  // wave-3 ownerId migration.
  ownedEmailJobs EmailJob[] @relation("EmailJobOwner")
  apiKeys          ApiKey[]
  submissionEvents SubmissionEvent[]
  auditLogs        AuditLog[]
  adminNotes       AdminNote[] @relation("UserAdminNotes")
  adminNotesWritten AdminNote[] @relation("AdminNotesWritten")
  // Admin Control Plane (Phase 4) — plans, subscriptions, usage.
  subscriptions         Subscription[]
  subscriptionEvents    SubscriptionEvent[] @relation("SubscriptionEventsByAdmin")
  planVersionsCreated   PlanVersion[] @relation("PlanVersionsCreatedBy")
  usageLedger           UsageLedger[]
  entitlementOverrides  EntitlementOverride[] @relation("EntitlementOverrideTarget")
  entitlementOverridesSet EntitlementOverride[] @relation("EntitlementOverrideAdmin")
  // Admin Control Plane (Phase 5) — AI BYOK keys + usage attribution.
  aiKeys                UserAiKey[]
  aiUsageRecords        AiUsageRecord[]
  aiSettings            UserAiSettings?
  // Phase 16, Wave 6 (BIL-092 completion): webhook/billing events
  // attributed to this user — the customer payment-history view.
  billingEvents         BillingEvent[] @relation("BillingEventUser")
  // Admin Control Plane (Phase 6) — MCP per-user controls + usage.
  mcpSettings           McpUserSettings?
  mcpUsageRecords       McpUsageRecord[]
  // Admin Control Plane (Phase 7) — platform operations.
  featureFlagOverrides      FeatureFlagOverride[] @relation("FeatureFlagOverrideTarget")
  featureFlagOverridesSet   FeatureFlagOverride[] @relation("FeatureFlagOverrideAdmin")
  deletionRequests          DeletionRequest[] @relation("DeletionRequestTarget")
  deletionRequestsReviewed  DeletionRequest[] @relation("DeletionRequestReviewedBy")
  announcementsCreated      Announcement[] @relation("AnnouncementsCreatedBy")
  // Admin Control Plane (Phase 8) — support tickets.
  supportTickets         SupportTicket[] @relation("SupportTicketOwner")
  supportTicketsAssigned SupportTicket[] @relation("SupportTicketAssignee")
  ticketMessages         TicketMessage[] @relation("TicketMessageAuthor")
  // Admin Control Plane (Phase 9) — step-up verifications.
  stepUpVerifications    StepUpVerification[]

  @@index([status])
  @@index([adminRole])
  @@index([createdAt])
  @@index([platformRole])
  @@index([emailVerified])
}

// ─── Admin Control Plane (Phase 3) ──────────────────────────────────────────
// Internal notes an admin writes about a user. Visible only in the admin
// app, never to the user themself. Deleting the user deletes their notes
// (Cascade); deleting the admin who wrote a note keeps the note with a
// null author (SetNull).
model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  adminId   String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation("UserAdminNotes", fields: [userId], references: [id], onDelete: Cascade)
  admin User? @relation("AdminNotesWritten", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Contact Forms (SendCMS) ─────────────────────────────────────────────────
// The legacy comment models (Site / Page / Comment / Commenter /
// ModerationLog / SiteMember / SiteInvite) were removed with the comment
// system (2026-11-18, owner-approved); `Domain` is the contact-form concept.

model Domain {
  id         String       @id @default(cuid())
  name       String
  // Normalized hostname only (lowercase, no scheme/path) — normalization
  // happens in the Phase 3 service. @unique: one owner record per domain.
  domain     String       @unique
  status     DomainStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  verifications DomainVerification[]
  formLinks     FormDomain[]

  @@index([status, createdAt])
  // Phase 16 (DB-014): analytics counts domains by ownerId + status.
  // The old standalone @@index([ownerId]) is dropped (DB-038) — a
  // strict prefix of [ownerId, status] below.
  @@index([ownerId, status])
}

model DomainVerification {
  id         String                   @id @default(cuid())
  method     DomainVerificationMethod
  // Crypto-random challenge token: the DNS TXT value / meta-tag content /
  // verification-file content the owner must publish.
  challenge  String
  status     DomainVerificationStatus @default(PENDING)
  verifiedAt DateTime?
  expiresAt  DateTime?
  attempts   Int                      @default(0)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  // Phase 16 (DB-038): @@index([domainId]) dropped — a strict prefix
  // of [domainId, status, createdAt] below; Postgres serves a
  // domainId-only lookup from the composite's leading column.
  @@index([domainId, status, createdAt])
}

model Form {
  id               String   @id @default(cuid())
  // Public identifier: the id itself is the public `formId` used by the
  // SDK / REST API together with the owner's public `userId` (User.id).
  name             String
  description      String?
  active           Boolean  @default(true)
  successMessage   String?
  redirectUrl      String?
  honeypotEnabled  Boolean  @default(true)
  turnstileEnabled Boolean  @default(false)
  // Phase 12 (AI digest): per-form opt-in for AI features
  // (spam re-scoring, digest, form-builder, reply drafts). Default OFF —
  // no submission content reaches a model provider unless the owner
  // enables AI for this form. No AI capability reads this field until
  // its own step ships; it is only the privacy gate.
  aiEnabled        Boolean  @default(false)
  // Phase 16 (EML-093): per-form digest opt-in, decoupled from
  // `aiEnabled` — the digest is a notification preference, not an AI
  // feature. Default OFF for new forms; the migration backfills TRUE
  // for forms that already had `aiEnabled` on, so no existing digest
  // stops. When AI is on for the form (and a model resolves) the
  // digest carries an AI summary; otherwise it is a plain list of
  // the new submissions.
  digestEnabled    Boolean  @default(false)
  // Phase 16 (EML-093/096): hours between digests for this form.
  // NULL = the platform default (AI_DIGEST_INTERVAL_HOURS, 24).
  // The dashboard offers daily (24) and weekly (168).
  digestIntervalHours Int?
  // Phase 12 (AI digest): when the last digest email was sent for this
  // form. NULL = never. The digest covers NEW submissions created after
  // this timestamp; the worker sends a new digest once the interval
  // (AI_DIGEST_INTERVAL_HOURS, default 24) has passed.
  lastDigestAt     DateTime?
  // Max submissions accepted per calendar day; null = unlimited.
  dailyLimit       Int?
  // Soft delete (Phase 16, SRC-208): deleting a form ARCHIVES it
  // instead of physically deleting the row, so its submission history
  // survives. NULL = live. Archived forms accept no submissions and
  // are hidden from every list/read path; the row stays recoverable
  // in the database. There is no restore path yet.
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  fields               FormField[]
  domainLinks          FormDomain[]
  submissions          Submission[]
  notificationSettings NotificationSettings[]
  emailJobs            EmailJob[]
  aiDailyUsage         AiDailyUsage[]

  // Phase 16 (DB-038): @@index([ownerId]) dropped — a strict prefix of
  // [ownerId, active] and [ownerId, deletedAt] below.
  @@index([ownerId, active])
  @@index([ownerId, deletedAt])
}

model FormDomain {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([formId, domainId])
  // Phase 16 (DB-038): @@index([formId]) dropped — a strict prefix of
  // the @@unique([formId, domainId]) above.
  @@index([domainId])
}

model FormField {
  id          String        @id @default(cuid())
  name        String // key in the submission payload, e.g. "email"
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  placeholder String?
  // Option list for SELECT / RADIO / CHECKBOX. Json is justified here: the
  // options are intrinsic to this one field definition, not shared rows.
  options     Json?
  minLength   Int?
  maxLength   Int?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, name])
  @@index([formId, order])
}

model Submission {
  id             String           @id @default(cuid())
  // Submitted field values, keyed by FormField.name. Json: fields vary
  // per form, so no fixed columns can hold them.
  data           Json
  status         SubmissionStatus @default(NEW)
  // Observed origin host at submit time, validated against the form's
  // linked domains. Denormalized on purpose: the string records what was
  // observed even if the Domain link is later removed — an inbox record
  // must not lose its origin. (See schema rules: denormalize with cause.)
  originDomain   String
  ipAddress      String?
  userAgent      String?
  pageUrl        String?
  // Idempotency-Key header value, if the client sent one. The composite
  // unique is the Phase 5 dedupe key; NULLs don't collide in Postgres.
  idempotencyKey String?
  // Hash of the canonical payload, for the Phase 5 content-hash dedupe window.
  contentHash    String?
  // Phase 12 (AI spam re-scoring): the model's 0–100 spam score and
  // when it was assigned. NULL = not yet scored. The score is a record
  // of the verdict, not a filter — the status is what the inbox reads.
  aiSpamScore    Int?
  aiScoredAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  // Denormalized owner (Phase 16, PRF-011): the form's owner at submit
  // time, set from form.ownerId on create and backfilled from Form for
  // existing rows. Denormalization is justified here (see schema rules):
  // every owner-scoped query (inbox, quota, analytics) filters
  // submissions by owner across forms, and all formId-leading indexes
  // are useless for that — without this column those queries join Form
  // and then collect + sort the owner's full submission set. Cascade
  // matches Form.owner: a hard user delete already cascades their
  // forms, which cascades these rows the same way (erasure anonymizes
  // the user row instead and never hard-deletes it — DB-005).
  ownerId String
  owner   User   @relation("SubmissionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  events    SubmissionEvent[]
  emailJobs EmailJob[]

  @@unique([formId, idempotencyKey])
  @@index([formId, status, createdAt])
  @@index([formId, createdAt])
  @@index([formId, contentHash, createdAt])
  // Phase 16 (PRF-011): owner-scoped inbox list / counts / quota check.
  @@index([ownerId, createdAt])
  @@index([ownerId, status, createdAt])
  // Phase 16 (DB-011): public-submit IP rate-limit counts filter on
  // ipAddress + createdAt with no formId.
  @@index([ipAddress, createdAt])
  // Phase 16 (DB-011): AI rescore candidates filter status = NEW AND
  // aiScoredAt IS NULL, ordered by createdAt. A partial index
  // (WHERE status = 'NEW' AND "aiScoredAt" IS NULL) would be smaller,
  // but Prisma cannot express partial indexes — it would be a
  // hand-written raw migration, invisible to the schema (the DB-020
  // drift problem). The plain composite stays Prisma-managed, serves
  // the rescore query, and also serves any other status + aiScoredAt
  // filter; the size saving of the partial form is not worth the drift.
  @@index([status, aiScoredAt, createdAt])
  // Phase 16 (PRF-012): bare date-range aggregates (admin overview /
  // health "submissions today") filter on createdAt alone.
  @@index([createdAt])
  // Phase 16 (PRF-019): hand-written trigram GIN indexes live outside
  // this schema — Prisma cannot express GIN indexes. Migration
  // 20261124162000_prf019_inbox_search_trgm creates the pg_trgm
  // extension plus:
  //   "Submission_originDomain_trgm_idx" (gin, "originDomain" gin_trgm_ops)
  //   "Submission_pageUrl_trgm_idx" (gin, "pageUrl" gin_trgm_ops)
  //   "Submission_data_text_trgm_idx" (gin, ("data"::text) gin_trgm_ops)
  // They serve the inbox search in packages/modules/inbox/src/service.ts
  // (buildInboxWhere), whose three leading-wildcard ILIKE branches name
  // exactly these expressions — the query is unchanged, only the access
  // path moves from seq scan to bitmap index scan. Do NOT re-create
  // these indexes in the schema (Prisma has no syntax for them) and do
  // NOT drop the migration. Drift check: `prisma migrate diff
  // --from-migrations --to-schema` is expected to report exactly these
  // three indexes plus the pg_trgm extension as drift, and nothing
  // else (the DB-020 pattern, same as "User_single_platform_owner_idx").
}

model SubmissionEvent {
  id        String              @id @default(cuid())
  type      SubmissionEventType
  // Extra context (e.g. old/new status). Append-only log row: createdAt
  // only (append-only, like AuditLog).
  detail    Json?
  createdAt DateTime            @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Who performed the action; null for system events (CREATED, EMAIL_*).
  // SetNull: the audit trail must survive the actor's deletion.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
  @@index([submissionId, type, createdAt])
  // Phase 16 (DB-012): every FK gets an index — the actor lookup.
  @@index([actorId])
}

model NotificationSettings {
  id        String   @id @default(cuid())
  // One row per (form, recipient): "form-specific + multiple recipients"
  // (Phase 8). A recipient is a row, not an inline list, so enabling /
  // disabling one address never touches the others.
  email     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, email])
  // Phase 16 (DB-038): @@index([formId]) dropped — a strict prefix of
  // the @@unique([formId, email]) above.
}

model EmailJob {
  id                String         @id @default(cuid())
  type              EmailJobType
  to                String
  subject           String
  status            EmailJobStatus @default(PENDING)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime?
  lastError         String?
  // Provider-side id (e.g. Resend message id) for delivery tracking.
  providerMessageId String?
  // Phase 12 (AI digest): the pre-rendered digest content for DIGEST
  // jobs (form name, count, model summary, highlights, submission
  // list). NULL for every other job type — those render from their
  // submission + form at send time instead. SUBMISSION_REPLY jobs
  // store the owner's reply body here instead.
  payload           Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Optional links: submission-notification jobs point at a form +
  // submission; verification / reset jobs point at neither. SetNull keeps
  // the delivery record if the form or submission is ever removed.
  formId String?
  form   Form?   @relation(fields: [formId], references: [id], onDelete: SetNull)

  // Denormalized owner (Phase 16, DB-034): the form's owner at enqueue
  // time, set from form.ownerId on create and backfilled from Form for
  // existing rows. Denormalization is justified here (see schema rules):
  // the owner-scoped outbox listing filters jobs by owner across
  // forms, and all formId-leading indexes are useless for that —
  // without this column the listing joins Form and then collects +
  // sorts the owner's full job set (Stream C proved the join still
  // seq-scans at 220k rows). Cascade matches Form.owner: a hard user
  // delete already cascades their forms, which cascades these rows
  // the same way (erasure anonymizes the user row instead and never
  // hard-deletes it — DB-005).
  ownerId String
  owner   User   @relation("EmailJobOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt, createdAt])
  @@index([type, createdAt])
  @@index([submissionId])
  // Phase 16 (DB-034): [formId, createdAt] serves the per-form
  // newest-first read. This also makes the old standalone
  // @@index([formId]) redundant (DB-038) — dropped.
  @@index([formId, createdAt])
  // Phase 16 (DB-034): owner-scoped "newest jobs first" listing
  // (listEmailJobsForUser) filters ownerId + createdAt DESC, with an
  // optional status filter.
  @@index([ownerId, createdAt])
  @@index([ownerId, status, createdAt])
}

model AuditLog {
  id           String        @id @default(cuid())
  action       AuditAction
  resourceType AuditResource
  resourceId   String
  // What changed (before/after, reason). Append-only log row: createdAt only.
  detail       Json?
  ipAddress    String?
  // Admin Control Plane (Phase 7) — the justification for the action
  // (required for critical actions), the request correlation id
  // (idempotency: one row per correlationId + action + resource), and
  // whether the action succeeded. `reason` is also stored in `detail`
  // by convention; the column makes it filterable.
  reason        String?
  correlationId String?
  outcome       AuditOutcome @default(SUCCESS)
  createdAt    DateTime      @default(now())

  // Who did it; null for system actions. SetNull preserves the log.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Idempotency (Phase 16, DB-004/SRC-331): one row per
  // (correlationId, action, resourceType, resourceId). Prisma cannot
  // express a partial unique index (correlationId is nullable — most
  // rows have none), so the constraint lives in a raw migration as
  // "AuditLog_correlation_idempotency_idx" (partial, WHERE
  // "correlationId" IS NOT NULL). logAudit inserts and treats the
  // unique-violation as "already logged".
  // Phase 16 (DB-013, Wave 3): the proposed composite
  // @@index([correlationId, action, resourceType, resourceId]) was
  // NOT added — the DB-004 partial unique above already indexes
  // exactly those four columns (leading with correlationId), so it
  // serves the idempotency pre-check; a second index would be pure
  // write overhead. No Session/Verification expiresAt index either:
  // no expiry sweep exists, so there is no query for it to serve.
  @@index([userId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([createdAt])
  @@index([correlationId])
  @@index([outcome, createdAt])
}

// ─── API keys (MCP auth, Phase 11) ──────────────────────────────────────────
// An API key is a per-user bearer credential for the MCP endpoint
// (POST /api/mcp). The plaintext key is shown ONCE at creation and never
// stored — only its SHA-256 hash lives here, so a leaked database reveals
// no usable key. `prefix` + `last4` let the owner tell keys apart in the
// dashboard without the secret. Revocation is a timestamp, not a delete:
// a revoked key stays visible (greyed out) so past usage stays
// attributable, and the row is never physically deleted.

model ApiKey {
  id    String      @id @default(cuid())
  // Human label, shown in the dashboard. Not unique — the key itself is
  // the identifier.
  name  String
  scope ApiKeyScope @default(FULL)
  // SHA-256 hex of the full key (never the key itself).
  keyHash String @unique
  // First 12 chars of the key (e.g. sk_live_aB3x) + last 4, for display.
  prefix  String
  last4   String
  // Updated on every successful MCP authentication (the resolve path).
  lastUsedAt DateTime?
  // Set on revoke (and on rotate, for the old key). Null = active.
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rateLimit ApiKeyRateLimit?
  mcpUsageRecords McpUsageRecord[]

  @@index([userId, revokedAt, createdAt])
  // Phase 16 (DB-038): @@index([userId]) dropped — a strict prefix of
  // [userId, revokedAt, createdAt] above.
}

model ApiKeyRateLimit {
  // One row per key: fixed-window counters for the MCP endpoint
  // (DB-backed, isolate-safe — the public submit's counting pattern, not
  // in-memory state). Created lazily on the key's first MCP call; keys
  // that never call MCP have no row.
  apiKeyId String @id
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  minuteWindowStart DateTime
  minuteCount       Int      @default(0)
  hourWindowStart   DateTime
  hourCount         Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 12 (AI spam re-scoring): one row per form per day, counting
// model calls. The daily cap (AI_DAILY_CALL_CAP, default 100) is
// enforced against this counter so one form's spam wave never becomes
// a billing event. Created lazily on the form's first AI call of the
// day; forms with AI off have no rows.
model AiDailyUsage {
  id     String   @id @default(cuid())
  formId String
  form   Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  // The day this row counts, as a DATE (UTC midnight). One row per
  // form per day.
  date   DateTime @db.Date
  calls  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, date])
  // Phase 16 (DB-038): @@index([formId]) dropped — a strict prefix of
  // the @@unique([formId, date]) above.
  // Phase 16 (DB-034): health aggregates AiDailyUsage by date alone
  // (all forms, one day) — no [date]-leading index existed.
  @@index([date])
}

// ─── Plans, subscriptions & usage (Admin Control Plane, Phase 4) ─────────────
// Versioned plans: a Plan is the stable identity (slug); a PlanVersion is
// one immutable snapshot of its price + entitlements. Editing a plan
// NEVER mutates a published version — it creates a new PlanVersion.
// Subscriptions always point at the version they were sold on, so a
// plan edit can never rewrite an existing customer's terms. Migration
// (admin-approved, recorded in SubscriptionEvent) is the only way a
// subscription moves to another version. Plans are never hard-deleted;
// ARCHIVED is the terminal state.

// A plan's stable identity. `currentVersionId` points at the currently
// published version (null until the first version is published).
model Plan {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  kind        PlanKind   @default(FREE)
  // Private plans are invisible to the public pricing page and can only
  // be assigned by an admin.
  isPrivate   Boolean    @default(false)
  status      PlanStatus @default(DRAFT)
  currentVersionId String?
  currentVersion PlanVersion? @relation("PlanCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions      PlanVersion[] @relation("PlanVersions")
  subscriptions Subscription[]

  // Phase 16 (DB-038): @@index([status]) dropped — a strict prefix of
  // [status, kind] below.
  @@index([kind])
  @@index([status, kind])
  // Phase 16 (DB-014): listPublishedPlans filters status = PUBLISHED
  // AND isPrivate = false.
  @@index([status, isPrivate])
  // Phase 16 (DB-012): every FK gets an index — currentVersionId is
  // only ever joined on (never filtered alone), but it is indexed for
  // uniformity with the other FKs rather than exempted.
  @@index([currentVersionId])
}

// One immutable snapshot of a plan's price + entitlements. `version`
// increments per plan (1, 2, 3…). A DRAFT version is editable only by
// creating a replacement draft — a PUBLISHED version is never updated
// in place; publishing a newer version SUPERSEDES the previous one.
// `entitlements` is Json validated by Zod (PlanEntitlementsSchema in
// @sendcms/plans) at the service boundary — never unchecked JSON.
model PlanVersion {
  id             String            @id @default(cuid())
  planId         String
  plan           Plan              @relation("PlanVersions", fields: [planId], references: [id], onDelete: Cascade)
  version        Int
  status         PlanVersionStatus @default(DRAFT)
  // Price in minor units (cents). Null = free.
  priceAmount    Int?
  priceCurrency  String            @default("USD")
  billingInterval BillingInterval  @default(MONTHLY)
  trialDays      Int               @default(0)
  entitlements   Json
  // Why this version exists (admin-supplied, shown in version history).
  changeReason   String?
  publishedAt    DateTime?
  createdById    String?
  createdBy      User?             @relation("PlanVersionsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions      Subscription[]
  currentForPlans    Plan[] @relation("PlanCurrentVersion")
  fromEvents         SubscriptionEvent[] @relation("SubscriptionEventFromVersion")
  toEvents           SubscriptionEvent[] @relation("SubscriptionEventToVersion")

  @@unique([planId, version])
  // Phase 16 (DB-038): @@index([planId]) dropped — a strict prefix of
  // the @@unique([planId, version]) above and of [planId, status].
  @@index([planId, status])
  @@index([status, publishedAt])
  // Phase 16 (DB-012): every FK gets an index — the creator lookup.
  @@index([createdById])
}

// A customer's entitlement to one plan version. The effective version
// (planVersionId) changes ONLY via an admin-approved migration, recorded
// in SubscriptionEvent. One ACTIVE subscription per user is enforced in
// the service (transaction: cancel the old one before creating the new
// one) — a DB partial unique index is not expressible in Prisma schema.
model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  planVersionId      String
  planVersion        PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  // Admin Control Plane (Phase 8) — the billing provider that sold this
  // subscription (null = assigned by an admin, no provider involved) and
  // the provider's own subscription id (used by webhooks to find the row).
  provider               BillingProvider?
  providerSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SubscriptionEvent[]

  @@index([userId, status])
  @@index([planId])
  @@index([planVersionId])
  @@index([status, currentPeriodEnd])
  // Phase 16 (DB-013): the webhook lookup filters
  // providerSubscriptionId + status IN (ACTIVE, TRIALING) ordered by
  // createdAt DESC — the bare [providerSubscriptionId] index cannot
  // serve the status filter + ordering. The bare index is dropped
  // (DB-038): it is a strict prefix of the composite below.
  @@index([providerSubscriptionId, status, createdAt])
  // Phase 16 (DB-038): @@index([userId]) dropped — a strict prefix of
  // [userId, status] above.
}

// Append-only history of every version transition on a subscription.
// Rollback is a new MIGRATED event back to a previous version — history
// is never rewritten.
model SubscriptionEvent {
  id                String                @id @default(cuid())
  subscriptionId    String
  subscription      Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type              SubscriptionEventType
  fromPlanVersionId String?
  fromPlanVersion   PlanVersion?          @relation("SubscriptionEventFromVersion", fields: [fromPlanVersionId], references: [id], onDelete: SetNull)
  toPlanVersionId   String?
  toPlanVersion     PlanVersion?          @relation("SubscriptionEventToVersion", fields: [toPlanVersionId], references: [id], onDelete: SetNull)
  adminId           String?
  admin             User?                 @relation("SubscriptionEventsByAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  reason            String?

  createdAt DateTime @default(now())

  @@index([subscriptionId, createdAt])
  @@index([subscriptionId, type, createdAt])
  // Phase 16 (DB-012): every FK gets an index — the version-transition
  // and admin lookups. Single-column indexes: no query filters
  // from+to together, so no pair composite is warranted.
  @@index([fromPlanVersionId])
  @@index([toPlanVersionId])
  @@index([adminId])
}

// Append-only metering ledger. One row per counted unit (or per batch
// with quantity > 1). `idempotencyKey` is unique so a retried operation
// can never double-count. `period` is the bucket start (month start for
// monthly meters, day start for daily meters). Quota checks aggregate
// this ledger — never scan all historical submissions per request.
model UsageLedger {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  meter          UsageMeter
  quantity       Int        @default(1)
  unit           String
  period         DateTime
  // What caused the usage, e.g. "submission:created", "mcp:tools/call".
  sourceEvent    String?
  // Unique per operation — retries with the same key are a no-op.
  idempotencyKey String     @unique
  // The resource counted, e.g. a formId, submissionId or apiKeyId.
  resourceId     String?

  createdAt DateTime @default(now())

  @@index([userId, meter, period])
  @@index([userId, meter, createdAt])
  @@index([period])
}

// Per-user admin override of one meter's limit (precedence 3 in
// entitlement resolution, above the subscription's plan version).
// `value` null = unlimited for that meter. `reason` is required —
// overrides are audited via AuditLog (ENTITLEMENT resource).
model EntitlementOverride {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation("EntitlementOverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  meter     UsageMeter
  value     Int?
  reason    String
  adminId   String?
  admin     User?      @relation("EntitlementOverrideAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, meter])
  // Phase 16 (DB-038): @@index([userId]) dropped — a strict prefix of
  // the @@unique([userId, meter]) above.
  @@index([expiresAt])
  // Phase 16 (DB-012): every FK gets an index — the admin lookup.
  @@index([adminId])
}

// ─── AI provider & BYOK (Admin Control Plane, Phase 5) ──────────────────────
// A customer's own AI provider key, stored ENCRYPTED (envelope
// encryption — see packages/ai/src/byok-crypto.ts), NEVER hashed: a
// hash is one-way and could never be used to call the provider. One
// key per provider per user (@@unique([userId, provider])). The
// plaintext key is NEVER stored, logged, returned by any API, or put
// in an audit record — only its SHA-256 fingerprint (for display and
// matching) is kept. "Browser only" keys never reach the server at
// all, so they have no row here; a row means "Both (browser +
// server)".

// Envelope layout (all base64): a random data key (DEK) encrypts the
// API key (AES-256-GCM, random IV, AAD binds userId + provider); the
// DEK itself is encrypted with the master key from .env
// (AI_BYOK_MASTER_KEY). Rotating the master key only re-encrypts the
// DEKs (masterKeyVersion tracks which master key encrypted a row).
model UserAiKey {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         AiProvider
  // The API key, encrypted with the row's DEK.
  encryptedKey     String
  // The DEK, encrypted with the master key.
  encryptedDek     String
  keyIv            String
  keyTag           String
  // SHA-256 hex of the plaintext key — display/matching only. It can
  // never be reversed into the key.
  keyFingerprint   String
  // The model the user chose for this provider (null = provider default).
  model            String?
  // A paused key is never used for resolution until re-enabled.
  isEnabled        Boolean         @default(true)
  // Increments when the user replaces the key (rotation history).
  keyVersion       Int             @default(1)
  // Which master key version encrypted this row's DEK.
  masterKeyVersion Int             @default(1)
  lastTestedAt     DateTime?
  lastTestStatus   AiKeyTestStatus @default(UNTESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  // Phase 16 (DB-038): @@index([userId]) dropped — a strict prefix of
  // the @@unique([userId, provider]) above.
  @@index([provider])
  @@index([userId, isEnabled])
}

// Platform-side provider configuration, set by an admin (never by a
// customer). The platform/master KEY itself lives in .env, same as
// Phase 12 — this row only controls whether the provider is available
// and which models it may use. Changes are audited via AuditLog.
model AiProviderConfig {
  id             String     @id @default(cuid())
  provider       AiProvider @unique
  isEnabled      Boolean    @default(true)
  // Model ids the platform key may call (Json string[]). Empty = the
  // provider default only.
  allowedModels  Json
  defaultModel   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 16 (DB-040): @@index([provider]) dropped — `provider` is
  // @unique, so the unique index already serves provider lookups.
}

// Cost attribution for one AI call. Billing mode is recorded per call
// so platform vs BYOK usage is never mixed up. Tokens are recorded
// when the provider reports them; costMicros (micro-dollars, 1e-6 USD)
// is set ONLY when the provider reports reliable usage/cost data —
// never an estimate presented as exact.
model AiUsageRecord {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     AiProvider
  model        String
  billingMode  AiBillingMode
  tokensIn     Int?
  tokensOut    Int?
  costMicros   Int?
  status       AiUsageStatus
  // What triggered the call, e.g. "spam-rescore", "suggest-fields",
  // "draft-reply", "key-test".
  sourceEvent  String?
  // The resource the call was for, e.g. a formId or submissionId.
  resourceId   String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@index([billingMode, createdAt])
  @@index([userId, billingMode, createdAt])
  // Phase 16 (DB-034 / PRF-012): date-range-only aggregations (admin
  // overview counts, provider-health groupBys) filter on createdAt
  // with no equality on any indexed leading column.
  @@index([createdAt])
}

// Per-user AI access settings (one row per user, created on first
// use). `billingMode` is the single source of truth for how this
// user's AI is billed: BYOK = their own key (the platform key is
// PAUSED for them while BYOK is selected, until they re-enable it);
// PLATFORM = the system's .env key (the default); DISABLED = no AI.
// Validated against the effective plan entitlements (aiByokAllowed /
// aiPlatformAllowed) whenever it is set.
model UserAiSettings {
  id          String        @id @default(cuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingMode AiBillingMode @default(PLATFORM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 16 (DB-040): @@index([userId]) dropped — `userId` is
  // @unique, so the unique index already serves userId lookups.
}

// ─── MCP controls (Admin Control Plane, Phase 6) ────────────────────────────

enum McpUsageStatus {
  SUCCESS
  FAILED
}

// Platform-wide MCP switch, set by an admin from /admin/mcp. ONE row
// (the service upserts it on first read). When globalEnabled is
// false, EVERY MCP call is refused with 503 — the kill-switch. This
// is separate from the Phase 4 platform emergency flag in
// config/config.json (which also zeroes AI and needs a restart to
// change); the MCP switch flips from the admin UI with no restart.
// It never touches form submission, the inbox, or any non-MCP
// service. Changes are audited via AuditLog (MCP_SETTINGS).
model McpSettings {
  id            String   @id @default(cuid())
  globalEnabled Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-user MCP controls (one row per user, created on first use).
// `isEnabled` false = this user cannot call MCP at all (their keys
// authenticate but every tool call is refused). `allowedTools` is the
// per-tool allowlist: null = every tool the key's scope allows;
// an explicit list = only those tools (an empty list = no tools).
// `minuteLimit` / `hourLimit` override the plan entitlements for
// this user; null = the plan's limits (then the platform defaults
// 120/min + 2000/hour). Changes are audited (MCP_SETTINGS).
model McpUserSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEnabled    Boolean  @default(true)
  allowedTools Json?
  minuteLimit  Int?
  hourLimit    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 16 (DB-038): @@index([userId]) dropped — `userId` is
  // @unique, so the unique index already serves userId lookups
  // (same pattern as DB-040's AiProviderConfig / UserAiSettings).
}

// One row per MCP tool call — the analytics source (per-tool,
// per-user, per-key). MCP volume is developer-driven, not form
// volume, so per-call rows are honest and cheap. A row is written
// for every call the MCP endpoint accepts for execution, including
// failed tool executions (status FAILED); calls refused BEFORE
// execution (kill-switch, disabled user, disallowed tool, over
// quota) are NOT recorded here — they are rate-limit/audit events,
// not tool usage. Never contains request arguments or results.
model McpUsageRecord {
  id         String         @id @default(cuid())
  apiKeyId   String
  apiKey     ApiKey         @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool       String
  status     McpUsageStatus
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([tool, createdAt])
  @@index([userId, tool, createdAt])
  // Phase 16 (DB-034 / PRF-012): date-range-only aggregations (health
  // groupBy status over the last 24h) filter on createdAt alone.
  @@index([createdAt])
}

// ─── Platform operations (Admin Control Plane, Phase 7) ─────────────────────
// Feature flags are DB-backed, NOT config.json — the admin UI flips them
// with no restart. The Phase 4 emergency flag in config.json stays the
// separate restart-gated kill-switch. Precedence: per-user override →
// global flag → off. An unknown key is OFF (fail-closed). NO flag is
// consumed by any feature yet — the registry + `isFeatureEnabled` API
// is the Phase 7 deliverable; wiring gates into features is Phase 8.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  overrides FeatureFlagOverride[]
}

// Per-user override of one flag. `reason` is required — an override is
// an admin decision, not a toggle. One override per (flag, user).
model FeatureFlagOverride {
  id        String   @id @default(cuid())
  flagId    String
  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("FeatureFlagOverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  isEnabled Boolean
  reason    String
  adminId   String?
  admin     User?    @relation("FeatureFlagOverrideAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flagId, userId])
  @@index([userId])
  // Phase 16 (DB-038): @@index([flagId]) dropped — a strict prefix of
  // the @@unique([flagId, userId]) above.
  // Phase 16 (DB-012): every FK gets an index — the admin lookup.
  @@index([adminId])
}

// Platform announcements. Active = isActive AND inside the optional
// [startsAt, endsAt] window. Audience ALL shows on the customer
// dashboard banner AND the admin overview; ADMIN_ONLY shows only in
// the admin app. Announcements are never sent by email, and never
// deleted — deactivation is the way to take one down.
model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  isActive    Boolean              @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdBy   User?                @relation("AnnouncementsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([audience, isActive])
  // Phase 16 (DB-014): listActiveAnnouncements filters isActive +
  // audience and orders by createdAt DESC — neither existing index
  // serves the ordering. The window predicates (startsAt/endsAt)
  // filter after the index range scan. The table is tiny, so this is
  // cheap insurance rather than a measured win.
  @@index([isActive, audience, createdAt])
  // Phase 16 (DB-012): every FK gets an index — the creator lookup.
  @@index([createdById])
}

// A deletion request and its review. The workflow: REQUESTED →
// APPROVED → COMPLETED (erasure executed) or REJECTED. The row is
// never deleted — it is the record the erasure happened. At most one
// REQUESTED/APPROVED request per user (enforced in the service, no DB
// unique). Erasure ANONYMIZES the user row (email → deleted-<id>@
// deleted.local, name → "Deleted user", image → null, status →
// DISABLED, deletionCompletedAt set) and deletes keys, sessions,
// BYOK keys, MCP settings, flag/plan overrides, admin notes, the
// user's domains/forms (cascade removes submissions, fields and
// notification settings), EmailJob rows addressed to the user or
// belonging to their forms, and Verification rows for the old email.
// AuditLog and SubscriptionEvent rows are KEPT (SetNull actor/user
// links — the audit trail survives erasure). Subscription,
// UsageLedger, AiUsageRecord and McpUsageRecord are Cascade off User
// (owner decision 2026-11-24, DB-005: keep Cascade): they survive
// erasure ONLY because erasure anonymizes the user row and never
// calls db.user.delete — a hard user delete WOULD delete them with
// the user.
// At most one open (REQUESTED/APPROVED) request per user — enforced
// by the partial unique index `DeletionRequest_one_open_idx` (raw
// migration 20261124131329; Prisma cannot express a partial unique
// index). The service pre-checks and translates a P2002 into a 409.
model DeletionRequest {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation("DeletionRequestTarget", fields: [userId], references: [id], onDelete: Cascade)
  status       DeletionRequestStatus @default(REQUESTED)
  reason       String
  reviewedById String?
  reviewedBy   User?                 @relation("DeletionRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  // Phase 16 (DB-012): every FK gets an index — the reviewer lookup.
  @@index([reviewedById])
}

// ─── Billing + support (Admin Control Plane, Phase 8) ───────────────────────

// Billing providers. The registry in @sendcms/billing must stay in sync
// with this enum.
enum BillingProvider {
  STRIPE
  PAYPAL
  GUMROAD
  FREEMIUS
  POLAR
}

// Support ticket lifecycle: OPEN → IN_PROGRESS → WAITING_ON_CUSTOMER →
// RESOLVED → CLOSED. Reopening returns a ticket to OPEN. Every
// transition is audited.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// One row per billing provider. `isEnabled` is the admin's switch — it
// can only be turned on when the provider's credentials exist in .env
// (enforced in the billing service, not the DB). Which countries the
// provider serves lives in BillingProviderCountry (no rows = everywhere,
// the default). Intended defaults, set from the admin app and never
// hardcoded: Stripe everywhere, PayPal US/GB/AU/DE and friends,
// Gumroad PK.
model BillingProviderConfig {
  id        String          @id @default(cuid())
  provider  BillingProvider @unique
  isEnabled Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  countries BillingProviderCountry[]
}

// Webhook idempotency: one row per provider event id. The webhook
// handler skips an event it has already processed, so a provider retry
// can never double-activate a subscription.
//
// Phase 16, Wave 6 (BIL-092 completion): `userId` links the event to
// the customer it belongs to, so the customer payment-history view can
// be owner-scoped. Set by the webhook handler — from the event for
// checkout-completed (it carries the buyer), from the subscription row
// for renewals/failures/cancels (resolved via providerSubscriptionId);
// null when the payload cannot identify a user (ignored events, or an
// event for a subscription SendCMS never activated). SetNull on user
// erasure: billing history survives erasure, the link does not.
model BillingEvent {
  id              String          @id @default(cuid())
  provider        BillingProvider
  providerEventId String
  eventType       String
  userId          String?
  user            User?           @relation("BillingEventUser", fields: [userId], references: [id], onDelete: SetNull)
  processedAt     DateTime?
  createdAt       DateTime        @default(now())
  // Phase 16 (DB-037): the row is updated after creation
  // (processedAt is set when the webhook is processed), so it carries
  // updatedAt like every other mutated model.
  updatedAt       DateTime        @updatedAt

  @@unique([provider, providerEventId])
  @@index([provider, createdAt])
  @@index([userId, createdAt])
}

// A support thread. Created by a signed-in user from /dashboard/support
// only — there is no public/anonymous ticket form on marketing.
model SupportTicket {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation("SupportTicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  assignedToId String?
  assignedTo   User?          @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages TicketMessage[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([assignedToId])
}

// One message in a support thread, from the customer or a staff member.
// Append-only: a correction is a new message, never an edit.
model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  // Phase 16 (DB-012): every FK gets an index — the author lookup.
  @@index([authorId])
}

// Reference list of countries (ISO 3166-1 alpha-2). The code IS the id —
// it is stable, unique, and the join table's FK target. Seeded by the
// migration (INSERT ... ON CONFLICT DO NOTHING). The admin UI fetches
// this list when setting up a billing provider; it is never hardcoded
// in code.
model Country {
  code String @id
  name String
  // Phase 16 (DB-016): createdAt only — seed rows are never mutated
  // (no updatedAt: there is no update path for reference data, and a
  // timestamp that can never change would be misleading). If Country
  // ever gains an admin edit path, add updatedAt with it.
  createdAt DateTime @default(now())

  providerCountries BillingProviderCountry[]

  @@index([name])
}

// Which countries a billing provider is enabled for. NO rows for a
// provider = all countries (the default). The admin picks countries
// from the Country table when setting up a provider.
model BillingProviderCountry {
  id               String                @id @default(cuid())
  providerConfigId String
  providerConfig   BillingProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  countryCode      String
  country          Country               @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  // Phase 16 (DB-016): admin-mutated configuration — createdAt records
  // when a mapping was added, updatedAt the last change. Both: this
  // table is mutated (rows are created/deleted when an admin sets a
  // provider's countries), unlike the Country reference rows above.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerConfigId, countryCode])
  @@index([countryCode])
}

// Fixed-window rate-limit scope. ADMIN_API = the admin REST API
// (per-user buckets); AUTH = auth sign-in attempts (per-IP and
// per-email buckets); STEP_UP = step-up password attempts (per-user
// buckets). A new scope needs a new enum value + migration.
enum RateLimitScope {
  ADMIN_API
  AUTH
  STEP_UP
}

// Phase 9 (admin rate limiting, ADR 0008 §6): one row per
// (scope, subject) — the generic fixed-window bucket behind the
// admin-API and auth sign-in limiters. Subjects are opaque strings:
// "user:<id>" for an authenticated admin caller, "ip:<ip>" for an
// unauthenticated caller, "email:<lowercased email>" for an auth
// sign-in attempt. Rows are created lazily on first use; the counters
// are advanced by a single INSERT ... ON CONFLICT ... RETURNING
// statement in @sendcms/security (rate-limit.ts), so concurrent
// requests cannot overshoot the limit. Rows are never deleted — a
// subject that stops calling keeps its last window (one row per
// subject, like ApiKeyRateLimit keeps one row per key).
model RateLimitBucket {
  id     String         @id @default(cuid())
  scope  RateLimitScope
  subject String

  minuteWindowStart DateTime
  minuteCount       Int      @default(0)
  hourWindowStart   DateTime
  hourCount         Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, subject])
}

// Step-up re-authentication (Admin Control Plane, Phase 9; single-use
// + action-bound since Phase 16 Wave 2): one row per successful
// password re-entry, before a high-impact action. A row authorizes
// exactly one action: `requireStepUp` accepts only an unexpired,
// unconsumed row whose `action` matches, and consumes it (sets
// `consumedAt`) in the same call — one password entry unlocks one
// action, never a 10-minute window over all of them. `action` is null
// for the legacy admin flow, which mints an unbound verification that
// only the action-less `requireStepUp(actor)` call accepts. Expired
// and consumed rows are pruned best-effort by the step-up helpers
// (`pruneStepUpVerifications`). No password material ever lives on
// this row (or anywhere else in the step-up flow) — the password is
// checked against the credential Account row and then dropped.
model StepUpVerification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The sensitive action this verification authorizes
  // ("change-password", "change-email", "2fa-enable", "2fa-disable");
  // null = legacy unbound verification (admin flow).
  action String?

  verifiedAt DateTime @default(now())
  expiresAt  DateTime

  // Set when the verification is spent by requireStepUp (single-use).
  consumedAt DateTime?

  // createdAt only: rows are never otherwise updated.
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([userId, action, expiresAt])
}
