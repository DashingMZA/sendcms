{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sendcms-marketing",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  // Per-app Cloudflare config (Phase 10). The public site — landing, terms, SEO routes.
  // The Cloudflare dashboard's Root directory for this project
  // must be apps/marketing — the build command runs there (see
  // infrastructure/cloudflare/README.md). The public URLs
  // below use the decided production domain (sendcms.bond) —
  // change the vars, never the code.
  "build": {
    "command": "pnpm --filter @sendcms/database db:generate && npx @opennextjs/cloudflare build",
  },
  // Dynamic Next.js App Router app (SSR + API routes + Prisma +
  // Better Auth), so it cannot run as plain static assets — the
  // Worker entry below serves it, and `.open-next/assets` holds
  // only the static files.
  "main": ".open-next/worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  // Bindings already configured in the Cloudflare dashboard — they
  // must also live here, otherwise the next `wrangler deploy`
  // drops them. NEXT_INC_CACHE_R2_BUCKET is the OpenNext
  // incremental cache (infrastructure/cloudflare/open-next.config.ts
  // enables the R2 cache); WORKER_SELF_REFERENCE is the self
  // reference the adapter's queue/revalidation uses; IMAGES powers
  // Next.js image optimization via Cloudflare Images.
  "images": {
    "binding": "IMAGES",
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "open-remark-opennext-cache",
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sendcms-marketing",
    },
  ],
  // LVE-014: Cloudflare built-in observability (logs + metrics) —
  // was `false` on every worker, so even the platform's own
  // telemetry was off. The uptime monitor + alert channel
  // themselves are owner-side (no provider is configured here).
  "observability": {
    "enabled": true,
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://sendcms.bond",
    "NEXT_PUBLIC_API_URL": "https://api.sendcms.bond",
    "NEXT_PUBLIC_DASHBOARD_URL": "https://dashboard.sendcms.bond",
    "NEXT_PUBLIC_DOCS_URL": "https://docs.sendcms.bond",
    "NEXT_PUBLIC_UPDATES_URL": "https://updates.sendcms.bond",
  },
  // This app needs no secrets (static content only).
}
