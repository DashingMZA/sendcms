{
  "name": "@sendcms/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:cf": "pnpm --filter @sendcms/database db:generate && pnpm -w run sdk:build && opennextjs-cloudflare build",
    "build:server": "pnpm --filter @sendcms/database db:generate && next build",
    "dev": "dotenv run -f ../../.env -- next dev --turbopack --port 3002",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@sendcms/ai-settings": "workspace:*",
    "@sendcms/analytics": "workspace:*",
    "@sendcms/api-client": "workspace:*",
    "@sendcms/api-keys": "workspace:*",
    "@sendcms/auth": "workspace:*",
    "@sendcms/database": "workspace:*",
    "@sendcms/domains": "workspace:*",
    "@sendcms/email": "workspace:*",
    "@sendcms/forms": "workspace:*",
    "@sendcms/i18n": "workspace:*",
    "@sendcms/inbox": "workspace:*",
    "@sendcms/notifications": "workspace:*",
    "@sendcms/permissions": "workspace:*",
    "@sendcms/sdk": "workspace:*",
    "@sendcms/shared": "workspace:*",
    "@sendcms/ui": "workspace:*",
    "@sendcms/users": "workspace:*",
    "@tanstack/react-query": "^5.108.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@sendcms/config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "typescript": "6.0.3"
  }
}
