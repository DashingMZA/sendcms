{
  "dependencies": {
    "@sendcms/api-client": "workspace:*",
    "@sendcms/api-keys": "workspace:*",
    "@sendcms/auth": "workspace:*",
    "@sendcms/database": "workspace:*",
    "@sendcms/domains": "workspace:*",
    "@sendcms/email": "workspace:*",
    "@sendcms/forms": "workspace:*",
    "@sendcms/inbox": "workspace:*",
    "@sendcms/mcp": "workspace:*",
    "@sendcms/notifications": "workspace:*",
    "@sendcms/observability": "workspace:*",
    "@sendcms/submissions": "workspace:*",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@sendcms/config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "typescript": "6.0.3"
  },
  "name": "@sendcms/api",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:cf": "pnpm --filter @sendcms/database db:generate && pnpm -w run sdk:build && opennextjs-cloudflare build",
    "build:server": "pnpm --filter @sendcms/database db:generate && pnpm -w run sdk:build && next build",
    "dev": "dotenv run -f ../../.env -- next dev --turbopack --port 3001",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
