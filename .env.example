# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Auth (Better Auth 1.7.x, stable)
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Canonical auth-service URL (used for OAuth callbacks). In the split
# monorepo (Phase 7) the auth handler lives in the api app, so this is
# the api app's URL (dev: http://localhost:3001). The dashboard app
# posts to it cross-origin from the browser.
BETTER_AUTH_URL="http://localhost:3001"
# Other app origins allowed to call the auth handler cross-origin
# (comma-separated). Dev: the dashboard app. Production: the dashboard
# app's public URL.
TRUSTED_ORIGINS="http://localhost:3002"
# Browser-side auth client base URL (the api app's URL). Set in the
# dashboard app's env; unset = same-origin (single-app case).
NEXT_PUBLIC_AUTH_URL="http://localhost:3001"
# Session cookie domain for the subdomain split (Phase 10): when the
# apps run on subdomains of one domain, the session cookie needs
# Domain=<domain> to be shared across them. Unset = host-only cookies
# (current behavior, dev). Production only — never commit a value.
#COOKIE_DOMAIN="example.com"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Facebook OAuth - https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# App
# Public site URL (the marketing app). Used for canonical SEO metadata
# (sitemap, robots, JSON-LD) and the "home" links on the sibling apps.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public URLs of the sibling apps (Phase 8). The SDK bundle is served
# by the api app, so the snippet's script src + the REST examples point
# there; the marketing page's sign-in links point at the dashboard app,
# and its changelog link at the updates app. Each app reads only the
# URLs it links to — unset = the dev port below. The api app also reads
# NEXT_PUBLIC_DASHBOARD_URL (Phase 9): the notification emails' inbox
# links point at the dashboard app.
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3003"
NEXT_PUBLIC_UPDATES_URL="http://localhost:3004"
# Structured log level: info / warn / error (default info).
# LOG_LEVEL=info

# Platform SMTP (transactional auth mail: email verification + password reset).
# Resend is the primary provider when RESEND_API_KEY is set (see below);
# SMTP is the fallback. Without either, dev logs the links to the server
# console and production sign-up/reset fails loudly.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Full "Name <address>" mailbox or a bare address, e.g. "SendCMS <notifications@csofts.tech>"
SMTP_FROM=""

# Cloudflare Turnstile (Phase 5) — only needed when a form enables
# Turnstile. The secret stays server-side; the site key goes to the SDK
# (Phase 6) as NEXT_PUBLIC_TURNSTILE_SITE_KEY.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Email notifications (Phase 8) ---
# Resend (recommended): create an API key at https://resend.com/api-keys
# and verify a sending domain at https://resend.com/domains. The From
# address must be on a domain verified in Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM=SendCMS <notifications@example.com>
# Cron worker for the email outbox (retrying failed jobs): the scheduler
# sends this as `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=
# Standalone email worker (Phase 9) — an alternative to the cron route
# for deployments that run a long-lived process. Polls the outbox every
# WORKER_POLL_INTERVAL_MS and serves GET /health on WORKER_PORT.
# WORKER_PORT=3005
# WORKER_POLL_INTERVAL_MS=30000

# --- AI features (Phase 12) ---
# All AI is per-form opt-in (the "AI features" toggle in form
# settings, off by default). No submission content reaches a model
# provider for a form that has not opted in, and no AI feature runs
# without a provider key — without one, the features are clean no-ops
# (spam stays heuristic-only, no digest is sent, no draft is made).
# Set ONE provider key to enable AI. AI_PROVIDER pins the provider
# when more than one key is set (openai | anthropic | google |
# deepseek | openrouter); unset = auto-detect from the keys present.
# AI_MODEL overrides the per-provider default model.
# AI_PROVIDER=google
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# AI_MODEL=
# Default models: openai gpt-4o-mini, anthropic claude-haiku-4-5,
# google gemini-3.5-flash-lite, deepseek deepseek-chat,
# openrouter openai/gpt-4o-mini.
# Spam re-scoring: a submission scoring at/above AI_SPAM_THRESHOLD
# (0–100, default 70) is marked SPAM.
# AI_SPAM_THRESHOLD=70
# Model calls allowed per form per day (default 100). A form that hits
# its cap is skipped until the next day.
# AI_DAILY_CALL_CAP=100
# Inbox digest interval in hours (default 24 = daily; 168 = weekly).
# AI_DIGEST_INTERVAL_HOURS=24
# BYOK master key (Phase 5, Admin Control Plane): 32 bytes, base64
# (44 chars) or hex (64 chars) — generate with `openssl rand -base64 32`.
# It encrypts customers' own AI keys at rest (envelope encryption);
# it is NEVER stored in the database. Without it, BYOK keys cannot be
# saved — the platform .env key keeps working.
# AI_BYOK_MASTER_KEY=

# --- Billing providers (Phase 8) ---
# A provider can be enabled in the admin app ONLY when its env values
# exist here. Without them the provider stays disabled and never
# appears at checkout. Keys are never shown in the admin UI — only
# whether they are set.
# Stripe (first): secret + publishable keys from the Stripe dashboard,
# plus the webhook signing secret for the /billing/webhooks/stripe
# endpoint (test keys start with sk_test_/pk_test_/whsec_).
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PayPal (second): client id + secret from a PayPal developer app,
# plus the webhook id of the webhook subscribed to billing events.
# PAYPAL_MODE=sandbox (sandbox | live; live only with live credentials)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# Polar (third): access token + webhook secret from the Polar
# dashboard. POLAR_ENVIRONMENT=sandbox by default; set to production
# with a production token for live charges.
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_ENVIRONMENT=sandbox
# Freemius (fourth): product id + API key + secret key + public key
# from the Freemius dashboard. Freemius plans are created in the
# Freemius dashboard, so map SendCMS plan versions to Freemius plan
# ids here (JSON object: { "<planVersionId>": "<freemiusPlanId>" }) —
# a version with no mapping cannot be sold through Freemius.
# FREEMIUS_PRODUCT_ID=
# FREEMIUS_API_KEY=
# FREEMIUS_SECRET_KEY=
# FREEMIUS_PUBLIC_KEY=
# FREEMIUS_PLAN_MAP=
# Gumroad (registered only — NO checkout): Gumroad has no API to
# create a payment or a subscription, so it can be toggled but never
# sells through SendCMS checkout.
# GUMROAD_APP_ID=
# GUMROAD_APP_SECRET=
