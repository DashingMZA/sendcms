# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Auth (Better Auth 1.7.x, stable)
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Canonical app URL (used for OAuth callbacks).
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Facebook OAuth - https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Widget JWT — separate secret for visitor tokens
WIDGET_JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Platform SMTP (transactional auth mail: email verification + password reset).
# Phase 8 replaces this with Resend. Without SMTP, dev logs the links to the
# server console and production sign-up/reset fails loudly.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
