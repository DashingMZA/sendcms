# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Auth (Better Auth 1.7.x, stable)
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Canonical app URL (used for OAuth callbacks).
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Phase 2: GitHub / Facebook OAuth (uncomment when adding)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# Widget JWT — separate secret for visitor tokens
WIDGET_JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
