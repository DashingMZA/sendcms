{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "BETTER_AUTH_URL",
    "TRUSTED_ORIGINS",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_DASHBOARD_URL",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PUBLIC_UPDATES_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_AUTH_URL"
  ],
  "globalPassThroughEnv": ["BETTER_AUTH_SECRET", "DATABASE_URL", "CRON_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "db:generate": { "cache": false },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    // TST-017: the SDK build writes outside its own package, into
    // apps/api/public/forms/ — the old "sdk:build" entry was dead
    // (no package defines an "sdk:build" script) and its
    // "public/forms/**" outputs matched nothing, so every build
    // warned "no output files found for task @sendcms/sdk#build".
    // The per-package override below declares the real outputs
    // (relative to packages/sdk), so the task is cacheable.
    "@sendcms/sdk#build": {
      "outputs": ["../../apps/api/public/forms/**"]
    },
    "test": { "dependsOn": ["^test"] },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
